# Copy to .env.local and fill in values. Never commit .env.local.

# Encord SDK auth (required by encord_pipeline/* scripts)
ENCORD_SSH_KEY_FILE=/path/to/your/encord_ssh_private_key

# Gemini key (used by encord_pipeline/step3_prelabel.py,
# loopback_api/intelligence/pattern_correlation.py, and the classifier
# service's Gemini fallback)
GOOGLE_API_KEY=

# ElevenLabs narration (frontend)
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Backend URLs (Vite reads VITE_* at build time; uncomment to override defaults)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_CLASSIFIER_URL=http://localhost:8001
